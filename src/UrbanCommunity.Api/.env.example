DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=urban_community_db;Username=postgres;Password=your_password_here
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=your_super_secret_key_here_minimum_32_characters
JWT_ISSUER=UrbanCommunity
JWT_AUDIENCE=UrbanCommunityApp
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRY_DAYS=14
RABBIT_MQ_HOST=localhost
RABBIT_MQ_USER=guest
RABBIT_MQ_PASS=guest

# AI servisi
AI_SERVICE_BASE_URL=http://localhost:8000/
AI_API_KEY=your_internal_ai_api_key_here
LLM_PROVIDER=deepseek
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PORT=8000

# Dosya depolama: Local | Cloudinary
FILE_STORAGE_PROVIDER=Local

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Development admin (sadece ASPNETCORE_ENVIRONMENT=Development iken seed edilir)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=your_admin_password_here
DEV_ADMIN_FIRST_NAME=Admin
DEV_ADMIN_LAST_NAME=User

# =============================================
# DOCKER DEĞİŞKENLERİ (docker compose --env-file ile kullanılır)
# =============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=urban_community_db
# Docker PostgreSQL'in bilgisayardaki portu. Bilgisayarda kurulu bir PostgreSQL 5432'yi
# kullaniyorsa burada ve yukaridaki DB_CONNECTION_STRING'de 5433 kullanin.
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

API_PORT=5000

# Redis / Cache (docker compose --env-file ile API container'a aktarilir)
REDIS_PORT=6379
REDIS_CONNECTION_STRING=urban-community-redis:6379
CACHE_USE_REDIS=true
CACHE_KEY_PREFIX=urban-community:development
