<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>urban-community-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.1" />
    <!-- Aspire 13.4.6 pulls MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h); 2.5.303 is the patched release. -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UrbanCommunity.Api\UrbanCommunity.Api.csproj" IsAspireProjectResource="true" />
  </ItemGroup>

</Project>
